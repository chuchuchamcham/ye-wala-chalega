# Google "Web application" OAuth client ID for Sign in with Google.
# Get it at https://console.cloud.google.com/apis/credentials (see README notes).
# Leave empty to hide the Google button (the local username/password login still works).
# The backend needs the SAME value in its GOOGLE_CLIENT_ID env var.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
